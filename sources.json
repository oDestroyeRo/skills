{
  "version": 1,
  "sources": [
    {
      "id": "mattpocock",
      "repository": "https://github.com/mattpocock/skills.git",
      "ref": "main",
      "root": ".",
      "skills_manifest": ".claude-plugin/plugin.json",
      "exclude_paths": [
        ".agents",
        ".changeset",
        ".github",
        ".gitignore",
        ".out-of-scope",
        "AGENTS.md",
        "CLAUDE.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "GLOSSARY.md",
        "SCOPE.md",
        "package.json",
        "package-lock.json",
        "scripts"
      ]
    },
    {
      "id": "pstack",
      "repository": "https://github.com/cursor/plugins.git",
      "ref": "main",
      "root": "pstack",
      "skills_manifest": ".cursor-plugin/plugin.json",
      "exclude_paths": [".gitignore"]
    },
    {
      "id": "tstack",
      "repository": "https://github.com/t3dotgg/tstack.git",
      "ref": "main",
      "root": ".",
      "skill_roots": ["skills"]
    },
    {
      "id": "anthropic",
      "repository": "https://github.com/anthropics/skills.git",
      "ref": "main",
      "root": ".",
      "skill_roots": ["skills"],
      "description_overrides": {
        "claude-api": "Build applications with the Claude API and Anthropic SDKs. Covers model selection, streaming, tool use, MCP, agents, caching, token counting, and migration. Use for Claude-specific API and SDK implementation, debugging, and reference questions."
      },
      "license_filter": {
        "file": "LICENSE.txt",
        "allowed_sha256": [
          "bc6b3af2f331cbc7fb0da1344efb2cbe5877a31498b4d70dbc7000f3405a1362",
          "0d542e0c8804e39aa7f37eb00da5a762149dc682d7829451287e11b938e94594"
        ],
        "support_paths": ["THIRD_PARTY_NOTICES.md"]
      }
    },
    {
      "id": "mongodb",
      "repository": "https://github.com/mongodb/agent-skills.git",
      "ref": "main",
      "root": ".",
      "skill_roots": ["skills"],
      "exclude_paths": [
        ".agents",
        ".claude-plugin",
        ".cursor-plugin",
        ".gitattributes",
        ".github",
        ".gitignore",
        ".grok-plugin",
        "CONTRIBUTING.md",
        "GEMINI.md",
        "gemini-extension.json",
        "plugins",
        "testing",
        "tools"
      ]
    }
  ]
}
